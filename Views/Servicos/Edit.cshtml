@model Servico
@{ ViewData["Title"] = "Editar serviço"; }
<div class="page-heading"><div><p class="eyebrow">CATÁLOGO</p><h1>Editar serviço</h1></div></div>
<section class="panel form-panel"><form asp-action="Edit" asp-route-id="@Model.Id" method="post">
<input type="hidden" asp-for="Id" /><div asp-validation-summary="ModelOnly" class="validation"></div>
<label asp-for="Nome">Nome do serviço</label><input asp-for="Nome" /><span asp-validation-for="Nome" class="validation"></span>
<label asp-for="Preco">Preço (R$)</label><input asp-for="Preco" type="number" step="0.01" min="1" /><span asp-validation-for="Preco" class="validation"></span>
<label asp-for="DuracaoMinutos">Duração em minutos</label><input asp-for="DuracaoMinutos" type="number" min="5" /><span asp-validation-for="DuracaoMinutos" class="validation"></span>
<div class="form-actions"><button class="btn gold" type="submit">Salvar alterações</button><a class="btn secondary" asp-action="Index">Cancelar</a></div>
</form></section>
