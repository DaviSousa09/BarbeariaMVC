@model Servico
@{ ViewData["Title"] = "Novo serviço"; }
<div class="page-heading"><div><p class="eyebrow">CATÁLOGO</p><h1>Novo serviço</h1></div></div>
<section class="panel form-panel"><form asp-action="Create" method="post">
<div asp-validation-summary="ModelOnly" class="validation"></div>
<label asp-for="Nome">Nome do serviço</label><input asp-for="Nome" placeholder="Ex.: Corte masculino" /><span asp-validation-for="Nome" class="validation"></span>
<label asp-for="Preco">Preço (R$)</label><input asp-for="Preco" type="number" step="0.01" min="1" /><span asp-validation-for="Preco" class="validation"></span>
<label asp-for="DuracaoMinutos">Duração em minutos</label><input asp-for="DuracaoMinutos" type="number" min="5" /><span asp-validation-for="DuracaoMinutos" class="validation"></span>
<div class="form-actions"><button class="btn gold" type="submit">Salvar serviço</button><a class="btn secondary" asp-action="Index">Cancelar</a></div>
</form></section>
