@model Barbeiro
@{ ViewData["Title"] = "Editar barbeiro"; }
<div class="page-heading"><div><p class="eyebrow">EQUIPE</p><h1>Editar barbeiro</h1></div></div>
<section class="panel form-panel"><form asp-action="Edit" asp-route-id="@Model.Id" method="post">
<input type="hidden" asp-for="Id" /><div asp-validation-summary="ModelOnly" class="validation"></div>
<label asp-for="Nome">Nome completo</label><input asp-for="Nome" /><span asp-validation-for="Nome" class="validation"></span>
<label asp-for="Telefone">Telefone</label><input asp-for="Telefone" />
<label asp-for="Especialidade">Especialidade</label><input asp-for="Especialidade" />
<div class="form-actions"><button class="btn gold" type="submit">Salvar alterações</button><a class="btn secondary" asp-action="Index">Cancelar</a></div>
</form></section>
