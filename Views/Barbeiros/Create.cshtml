@model Barbeiro
@{ ViewData["Title"] = "Novo barbeiro"; }
<div class="page-heading"><div><p class="eyebrow">EQUIPE</p><h1>Novo barbeiro</h1></div></div>
<section class="panel form-panel"><form asp-action="Create" method="post">
<div asp-validation-summary="ModelOnly" class="validation"></div>
<label asp-for="Nome">Nome completo</label><input asp-for="Nome" placeholder="Ex.: Rafael Oliveira" /><span asp-validation-for="Nome" class="validation"></span>
<label asp-for="Telefone">Telefone</label><input asp-for="Telefone" placeholder="(00) 00000-0000" />
<label asp-for="Especialidade">Especialidade</label><input asp-for="Especialidade" placeholder="Ex.: Degradê e freestyle" />
<div class="form-actions"><button class="btn gold" type="submit">Salvar barbeiro</button><a class="btn secondary" asp-action="Index">Cancelar</a></div>
</form></section>
