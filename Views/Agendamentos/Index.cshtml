@model IEnumerable<Agendamento>
@inject BarbeariaMVC.Data.BarbeariaRepository Dados
@{ ViewData["Title"] = "Agendamentos"; }
<div class="page-heading"><div><p class="eyebrow">AGENDA</p><h1>Agendamentos</h1><p>Visualize e gerencie os horários marcados.</p></div><a class="btn gold" asp-action="Create">＋ Novo agendamento</a></div>
<section class="panel">
@if (!Model.Any()) { <p class="empty">Nenhum agendamento cadastrado.</p> }
else { <div class="table-wrap"><table><thead><tr><th>Data e hora</th><th>Cliente</th><th>Serviço</th><th>Barbeiro</th><th>Status</th><th>Ações</th></tr></thead><tbody>
@foreach (var item in Model) { <tr>
<td>@item.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
<td>@(Dados.BuscarCliente(item.ClienteId)?.Nome ?? "—")</td>
<td>@(Dados.BuscarServico(item.ServicoId)?.Nome ?? "—")</td>
<td>@(Dados.BuscarBarbeiro(item.BarbeiroId)?.Nome ?? "—")</td>
<td><span class="status @(item.Status == "Concluído" ? "done" : "")">@item.Status</span></td>
<td class="actions"><a class="text-link" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
@if (item.Status == "Agendado") { <form asp-action="Concluir" asp-route-id="@item.Id" method="post"><button class="link-success">Concluir</button></form> }
<form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirmarExclusao('este agendamento')"><button class="link-danger">Excluir</button></form></td>
</tr> }
</tbody></table></div> }
</section>
