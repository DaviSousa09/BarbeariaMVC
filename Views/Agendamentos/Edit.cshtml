@model Agendamento
@{ ViewData["Title"] = "Editar agendamento"; }
<div class="page-heading"><div><p class="eyebrow">AGENDA</p><h1>Editar agendamento</h1></div></div>
<section class="panel form-panel"><form asp-action="Edit" asp-route-id="@Model.Id" method="post">
<input type="hidden" asp-for="Id" /><div asp-validation-summary="ModelOnly" class="validation"></div>
<label asp-for="ClienteId">Cliente</label><select asp-for="ClienteId" asp-items="ViewBag.Clientes"></select>
<label asp-for="ServicoId">Serviço</label><select asp-for="ServicoId" asp-items="ViewBag.Servicos"></select>
<label asp-for="BarbeiroId">Barbeiro</label><select asp-for="BarbeiroId" asp-items="ViewBag.Barbeiros"></select>
<label asp-for="DataHora">Data e horário</label><input asp-for="DataHora" type="datetime-local" value="@Model.DataHora.ToString("yyyy-MM-ddTHH:mm")" /><span asp-validation-for="DataHora" class="validation"></span>
<label asp-for="Status">Status</label><select asp-for="Status"><option>Agendado</option><option>Concluído</option><option>Cancelado</option></select>
<label asp-for="Observacao">Observações</label><textarea asp-for="Observacao" rows="3"></textarea>
<div class="form-actions"><button class="btn gold" type="submit">Salvar alterações</button><a class="btn secondary" asp-action="Index">Cancelar</a></div>
</form></section>
