@model Agendamento
@{ ViewData["Title"] = "Novo agendamento"; }
<div class="page-heading"><div><p class="eyebrow">AGENDA</p><h1>Novo agendamento</h1></div></div>
<section class="panel form-panel"><form asp-action="Create" method="post">
<div asp-validation-summary="ModelOnly" class="validation"></div>
<label asp-for="ClienteId">Cliente</label><select asp-for="ClienteId" asp-items="ViewBag.Clientes"><option value="">Selecione um cliente</option></select><span asp-validation-for="ClienteId" class="validation"></span>
<label asp-for="ServicoId">Serviço</label><select asp-for="ServicoId" asp-items="ViewBag.Servicos"><option value="">Selecione um serviço</option></select><span asp-validation-for="ServicoId" class="validation"></span>
<label asp-for="BarbeiroId">Barbeiro</label><select asp-for="BarbeiroId" asp-items="ViewBag.Barbeiros"><option value="">Selecione um barbeiro</option></select><span asp-validation-for="BarbeiroId" class="validation"></span>
<label asp-for="DataHora">Data e horário</label><input asp-for="DataHora" type="datetime-local" value="@Model.DataHora.ToString("yyyy-MM-ddTHH:mm")" /><span asp-validation-for="DataHora" class="validation"></span>
<label asp-for="Observacao">Observações (opcional)</label><textarea asp-for="Observacao" rows="3" placeholder="Alguma informação sobre o atendimento..."></textarea>
<div class="form-actions"><button class="btn gold" type="submit">Confirmar agendamento</button><a class="btn secondary" asp-action="Index">Cancelar</a></div>
</form></section>
